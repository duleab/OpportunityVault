# ── Server (server/.env) ──────────────────────────────────────────────────────

# Local PostgreSQL via docker-compose (recommended — matches production):
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Quick local dev without Docker (SQLite — change provider in schema.prisma to "sqlite" first):
# DATABASE_URL=file:./dev.db
# DIRECT_URL=file:./dev.db

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PORT=4000
CLIENT_URL=http://localhost:5173

# AI Providers (at least one required for extraction)
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZHIPU_API_KEY=             # Z.ai / ZhipuAI GLM-4 — get key at https://open.bigmodel.cn
OLLAMA_BASE_URL=http://localhost:11434

# Notifications
NTFY_DEFAULT_SERVER=https://ntfy.sh

# Notion export (optional)
NOTION_API_KEY=

# ── Client (client/.env) ──────────────────────────────────────────────────────

VITE_API_URL=http://localhost:4000/api

# ── Production (Supabase + Render + Vercel) ───────────────────────────────────
# See DEPLOYMENT.md for full setup instructions.
#
# Supabase (set both on Render):
#   DATABASE_URL = Session pooler URL (port 6543, ?pgbouncer=true)
#   DIRECT_URL   = Direct connection URL (port 5432)
#
# Render:
#   CLIENT_URL = https://your-app.vercel.app
#
# Vercel:
#   VITE_API_URL = https://your-api.onrender.com/api
